# The operator's guide. It is written for whoever runs this site and
# nobody else: it names the setup steps, the panel's own pages and how
# the database is arranged. None of it is needed to serve a page, and
# none of it should ever be readable over the web.
#
# The root .htaccess already refuses every .md file by name. This is the
# second, independent lock on the same door, so the guide stays private
# even if that file is replaced or a host ignores part of it. The guide
# can also simply be deleted from the live server: nothing on the site
# reads it.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
